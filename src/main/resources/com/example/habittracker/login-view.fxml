<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="500.0" prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.habittracker.controller.LoginController">
  <children>
    <GridPane styleClass="home-page">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
      </columnConstraints>
      <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
      </rowConstraints>
      <children>
        <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="login-brand">
          <padding>
            <Insets bottom="40.0" left="48.0" right="40.0" top="40.0" />
          </padding>
          <children>
            <Label styleClass="login-brand-title" text="EcoHabit" />
            <Label styleClass="login-brand-tagline" text="Habits for Tomorrow, Together" wrapText="true" />
          </children>
        </VBox>

        <StackPane GridPane.columnIndex="1">
          <children>
            <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="340.0" spacing="8.0" styleClass="card">
              <children>
                <Label styleClass="login-title" text="Welcome back!" />
                <Label styleClass="field-label" text="Username">
                  <VBox.margin>
                    <Insets top="12.0" />
                  </VBox.margin>
                </Label>
                <TextField fx:id="usernameTextField" styleClass="password-field" />
                <Label styleClass="field-label" text="Password">
                  <VBox.margin>
                    <Insets top="6.0" />
                  </VBox.margin>
                </Label>
                <PasswordField fx:id="passwordTextField" onAction="#onLoginConfirmButtonClicked" styleClass="password-field" />
                <Label fx:id="errorLabel" minHeight="20.0" styleClass="error-label" wrapText="true" />
                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLoginConfirmButtonClicked" styleClass="primary-button" text="Login" />
                <HBox alignment="CENTER" spacing="2.0">
                  <children>
                    <Label text="New here?" />
                    <Hyperlink fx:id="registerLink" onAction="#onGoToRegistrationButtonClicked" text="Register" />
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </StackPane>
      </children>
    </GridPane>

    <StackPane alignment="BOTTOM_LEFT"
                mouseTransparent="true"
                pickOnBounds="false">
      <Group scaleX="0.18" scaleY="0.18">
        <fx:include source="updatedscott.fxml"/>
      </Group>
      <StackPane.margin>
        <Insets left="12.0" bottom="8.0" />
      </StackPane.margin>
    </StackPane>
  </children>
</StackPane>
