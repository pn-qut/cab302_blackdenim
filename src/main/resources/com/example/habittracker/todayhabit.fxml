<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="home-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.habittracker.controller.TodayHabitController">

    <padding>
        <Insets bottom="40" left="50" right="50" top="40" />
    </padding>

    <HBox prefHeight="31.0" prefWidth="592.0" styleClass="header">
        <Label fx:id="greetingLabel" styleClass="page-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="dateLabel" alignment="CENTER_RIGHT" contentDisplay="RIGHT" styleClass="date-label" textAlignment="RIGHT" />
    </HBox>

    <HBox spacing="24" VBox.vgrow="ALWAYS">


        <VBox spacing="12" HBox.hgrow="ALWAYS">
            <VBox spacing="12" styleClass="card">
                <Label styleClass="card-title" text="This Month's Community Goal" />
                <ListView fx:id="communityGoal" prefHeight="120.0" />
            </VBox>

        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              styleClass="card">
            <Label text="Today's habits"
                   styleClass="card-title"/>

            <ListView fx:id="todayHabitsList"
                      VBox.vgrow="ALWAYS"/>

            <Button text="+ Add a habit"
                    onAction="#onAddHabitClicked"
                    maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="24"
              prefWidth="320"
              minWidth="280">

            <HBox styleClass="card">
                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="streakLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="day streak"
                           styleClass="stat-caption"/>
                </VBox>

                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="scoreLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="score this month"
                           styleClass="stat-caption"/>
                </VBox>

                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="totalScoreLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="total score"
                           styleClass="stat-caption"/>
                </VBox>
            </HBox>

            <VBox spacing="12"
                  VBox.vgrow="ALWAYS"
                  styleClass="card">
                <Label text="This week's progress"
                       styleClass="card-title"/>

                <VBox fx:id="weeklyProgressBox"
                      spacing="10"/>
                </VBox>
            </VBox>

        </HBox>

</VBox>
