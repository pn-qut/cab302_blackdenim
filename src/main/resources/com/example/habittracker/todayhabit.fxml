<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.habittracker.controller.TodayHabitController"
      spacing="20"
      styleClass="home-page">

    <padding>
        <Insets top="40"
                right="50"
                bottom="40"
                left="50"/>
    </padding>

    <Label text="Today's habits"
           styleClass="page-title"/>

    <ListView fx:id="todayList"
              VBox.vgrow="ALWAYS"/>

    <Button text="+ Add a habit"
            onAction="#onSeeAllHabits"
            maxWidth="Infinity"/>

</VBox>
