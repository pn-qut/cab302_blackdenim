<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.habittracker.controller.TodayHabitController"
      spacing="20"
      styleClass="home-page">

    <padding>
        <Insets top="40"
                right="50"
                bottom="40"
                left="50"/>
    </padding>

    <VBox styleClass="header">
        <Label fx:id="dateLabel"
               styleClass="date-label"/>
        <Label fx:id="greetingLabel"
               styleClass="page-title"/>
    </VBox>

    <HBox spacing="24"
          VBox.vgrow="ALWAYS">

        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              styleClass="card">
            <Label text="Today's habits"
                   styleClass="card-title"/>

            <ListView fx:id="todayHabitsList"
                      VBox.vgrow="ALWAYS"/>

            <Button text="+ Add a habit"
                    onAction="#onAddHabitClicked"
                    maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="24"
              prefWidth="320"
              minWidth="280">

            <HBox styleClass="card">
                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="streakLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="day streak"
                           styleClass="stat-caption"/>
                </VBox>

                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="scoreLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="score this month"
                           styleClass="stat-caption"/>
                </VBox>

                <VBox styleClass="stat"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="totalScoreLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="total score"
                           styleClass="stat-caption"/>
                </VBox>
            </HBox>

            <VBox spacing="12"
                  VBox.vgrow="ALWAYS"
                  styleClass="card">
                <Label text="This week's progress"
                       styleClass="card-title"/>

                <VBox fx:id="weeklyProgressBox"
                      spacing="10"/>
            </VBox>
        </VBox>

    </HBox>

</VBox>
