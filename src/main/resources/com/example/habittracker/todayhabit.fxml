<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" styleClass="home-page" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.habittracker.controller.TodayHabitController">

    <padding>
        <Insets bottom="40" left="50" right="50" top="40" />
    </padding>

    <VBox styleClass="header">
        <Label fx:id="dateLabel" styleClass="date-label" />
    </VBox>

    <HBox spacing="24" VBox.vgrow="ALWAYS">

        <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
         <ListView fx:id="communityGoal" prefHeight="60.0" prefWidth="176.0" />
           <Label fx:id="greetingLabel" styleClass="page-title" />
            <Label styleClass="card-title" text="Today's habits" />

            <Label fx:id="scoreLabel" styleClass="score-label" text="Score: 0" />

            <ListView fx:id="todayHabitsList" VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#onAddHabitClicked" text="+ Add a habit" />
        </VBox>

        <VBox minWidth="280" prefWidth="320" spacing="12" styleClass="card">
            <Label styleClass="card-title" text="This week's progress" />

            <VBox fx:id="weeklyProgressBox" spacing="10" />
        </VBox>

    </HBox>

</VBox>
