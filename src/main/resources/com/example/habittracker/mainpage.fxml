<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.habittracker.controller.MainShellController">

    <left>
        <VBox spacing="24"
              prefWidth="260"
              styleClass="navigation">

            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <Button text="Home"
                    onAction="#onHomeClicked"
                    maxWidth="Infinity"/>

            <Button text="Habits"
                    onAction="#onHabitsClicked"
                    maxWidth="Infinity"/>

            <Button text="Community Goals"
                    onAction="#onCommunityGoalsClicked"
                    maxWidth="Infinity"/>

            <Button text="Leaderboard"
                    onAction="#onLeaderboardClicked"
                    maxWidth="Infinity"/>

            <Button text="Achievements"
                    onAction="#onAchievementsClicked"
                    maxWidth="Infinity"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="Profile"
                    onAction="#onProfileClicked"
                    maxWidth="Infinity"/>

            <Button text="Settings"
                    onAction="#onSettingsClicked"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>
