<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane styleClass="home-page" prefHeight="500.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.habittracker.controller.RegistrationController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
    <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints vgrow="ALWAYS" />
  </rowConstraints>
  <children>
    <VBox alignment="CENTER_LEFT" spacing="8.0" styleClass="login-brand">
      <padding>
        <Insets bottom="40.0" left="48.0" right="40.0" top="40.0" />
      </padding>
      <children>
        <Label styleClass="login-brand-title" text="EcoHabit" />
        <Label styleClass="login-brand-tagline" text="Habits for Tomorrow, Together" wrapText="true" />
      </children>
    </VBox>

    <StackPane GridPane.columnIndex="1">
      <children>
        <VBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="340.0" spacing="8.0" styleClass="card">
          <children>
            <Label styleClass="login-title" text="Welcome to EcoHabit!" />
            <Label styleClass="field-label" text="Set Username">
              <VBox.margin>
                <Insets top="8.0" />
              </VBox.margin>
            </Label>
            <TextField fx:id="usernameTextField" styleClass="password-field" />
            <Label styleClass="field-label" text="Set Password">
              <VBox.margin>
                <Insets top="4.0" />
              </VBox.margin>
            </Label>
            <PasswordField fx:id="passwordTextField" styleClass="password-field" />
            <Label styleClass="field-label" text="Queensland Postcode">
              <VBox.margin>
                <Insets top="4.0" />
              </VBox.margin>
            </Label>
            <TextField fx:id="postcodeTextField" onAction="#onRegisterConfirmButtonClicked" promptText="e.g. 4000" styleClass="password-field" />
            <Label fx:id="errorLabel" minHeight="20.0" styleClass="error-label" wrapText="true" />
            <Button fx:id="registerConfirmButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onRegisterConfirmButtonClicked" styleClass="primary-button" text="Create Account" />
            <HBox alignment="CENTER" spacing="2.0">
              <children>
                <Label text="Already have an account?" />
                <Hyperlink fx:id="loginLink" onAction="#onGoToLoginButtonClicked" text="Login" />
              </children>
            </HBox>
          </children>
        </VBox>
      </children>
    </StackPane>
  </children>
</GridPane>
